# ==========================================
# KelolaUang - Environment Variables Template
# ==========================================
# Salin file ini menjadi .env.local untuk pengembangan lokal:
# cp .env.example .env.local

# URL Proyek Supabase Anda (didapatkan dari Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon / Public Key (Aman digunakan di browser dengan RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
